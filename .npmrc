auto-install-peers=false
strict-peer-dependencies=false
# pnpm 11 runs an automatic deps-status check before every workspace command
# (e.g. `pnpm --filter <pkg> run dev`). On Windows that internal child install
# trips ERR_PNPM_IGNORED_BUILDS for core-js / esbuild even when they're
# allow-listed. Disabling the pre-run check makes `pnpm run dev` start
# instantly and skips that gate entirely.
verify-deps-before-run=false
# Belt-and-suspenders: also disable the builds-approval prompt on install
# itself so a fresh `pnpm install` never blocks waiting for user input.
confirm-modules-purge=false
